<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F9FA">

    <!-- ENCABEZADO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#0797A8"
        android:padding="18dp">

        <TextView
            android:id="@+id/btnVolverDetalleDonacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹"
            android:textSize="32sp"
            android:textColor="#FFFFFF"
            android:paddingEnd="20dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detalle de donación"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- TARJETA DONANTE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_donacion_tarjeta"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DATOS DEL DONANTE"
                    android:textColor="#0797A8"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/txtDetalleNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cargando..."
                    android:textColor="#163B4A"
                    android:textStyle="bold"
                    android:textSize="19sp"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:id="@+id/txtDetalleDni"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cargando..."
                    android:textColor="#597487"
                    android:textSize="14sp"/>

            </LinearLayout>

            <!-- TARJETA DONACIÓN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_donacion_tarjeta"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="INFORMACIÓN DE LA DONACIÓN"
                    android:textColor="#0797A8"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="20dp"/>

                <!-- FECHA -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fecha de donación"
                    android:textColor="#597487"
                    android:textSize="13sp"
                    android:layout_marginBottom="5dp"/>

                <TextView
                    android:id="@+id/txtDetalleFecha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cargando..."
                    android:textColor="#163B4A"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="18dp"/>

                <!-- SEPARADOR -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E7EFF2"
                    android:layout_marginBottom="18dp"/>

                <!-- MODALIDAD -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Modalidad"
                    android:textColor="#597487"
                    android:textSize="13sp"
                    android:layout_marginBottom="5dp"/>

                <TextView
                    android:id="@+id/txtDetalleTipo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cargando..."
                    android:textColor="#F7065D"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="18dp"/>

                <!-- SEPARADOR -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E7EFF2"
                    android:layout_marginBottom="18dp"/>

                <!-- OBSERVACIONES -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Observaciones"
                    android:textColor="#597487"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/txtDetalleObservaciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cargando..."
                    android:textColor="#163B4A"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
