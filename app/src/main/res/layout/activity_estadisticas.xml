<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F9FA"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#0797A8"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/btnVolverEstadisticas"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:contentDescription="Volver"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="34sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estadísticas"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Período"
                android:textColor="#163B4A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spPeriodoEstadisticas"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:contentDescription="Seleccionar período" />

            <TextView
                android:id="@+id/txtEstadoEstadisticas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:text="Cargando..."
                android:textColor="#527080"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/contenedorEstadisticas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
