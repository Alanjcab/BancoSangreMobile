<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="#0797A8"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/btnVolver"
                android:layout_width="40dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:contentDescription="Volver" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ficha técnica"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- FORMULARIO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Evaluación del donante"
                android:textColor="#163B4A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDonanteEvaluado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Donante: -"
                android:textColor="#597487"
                android:textSize="14sp" />

            <!-- FECHA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Fecha de evaluación *"
                android:textColor="#163B4A"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtFechaEvaluacion"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_dato_celeste"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Seleccionar fecha"
                android:textColor="#597487"
                android:clickable="true"
                android:focusable="true" />

            <!-- HEMATOCRITO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Hematocrito (%)"
                android:textColor="#163B4A"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtHematocrito"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_dato_celeste"
                android:hint="Ej.: 43,2"
                android:inputType="numberDecimal"
                android:padding="14dp"
                android:textColor="#163B4A"
                android:textColorHint="#8199A8" />

            <!-- PLAQUETAS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Plaquetas (×10⁹/L)"
                android:textColor="#163B4A"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtPlaquetas"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_dato_celeste"
                android:hint="Ej.: 241"
                android:inputType="number"
                android:padding="14dp"
                android:textColor="#163B4A"
                android:textColorHint="#8199A8" />

            <!-- FENOTIPO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Fenotipo"
                android:textColor="#163B4A"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtFenotipo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_dato_celeste"
                android:hint="Ingresar fenotipo"
                android:inputType="textCapCharacters"
                android:padding="14dp"
                android:textColor="#163B4A"
                android:textColorHint="#8199A8" />

            <!-- PESO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Peso (kg)"
                android:textColor="#163B4A"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtPeso"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_dato_celeste"
                android:hint="Ej.: 68"
                android:inputType="numberDecimal"
                android:padding="14dp"
                android:textColor="#163B4A"
                android:textColorHint="#8199A8" />

            <!-- APTITUD -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Resultado de la evaluación *"
                android:textColor="#163B4A"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerAptitud"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_dato_celeste"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

            <!-- OBSERVACIONES -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Observaciones"
                android:textColor="#163B4A"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtObservaciones"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_dato_celeste"
                android:gravity="top"
                android:hint="Agregar observaciones..."
                android:inputType="textMultiLine"
                android:padding="14dp"
                android:textColor="#163B4A"
                android:textColorHint="#8199A8" />

            <!-- BOTÓN GUARDAR -->
            <TextView
                android:id="@+id/btnGuardarFicha"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_boton_fucsia"
                android:gravity="center"
                android:text="Guardar evaluación"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
