<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F9FA">

    <!-- encabezad -->
    <LinearLayout
        android:id="@+id/headerFormulario"
        android:layout_width="0dp"
        android:layout_height="105dp"
        android:background="@drawable/bg_header_decorativo"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btnVolverFormulario"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:contentDescription="Volver"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/txtTituloFormulario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nuevo usuario"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!--formulario-->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerFormulario">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Datos de acceso"
                android:textColor="#163B4A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!--nombre-->
            <EditText
                android:id="@+id/edtNombreUsuario"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input"
                android:hint="Nombre"
                android:inputType="textCapWords|textPersonName"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#163B4A" />

            <!--apeliido-->
            <EditText
                android:id="@+id/edtApellidoUsuario"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input"
                android:hint="Apellido"
                android:inputType="textCapWords|textPersonName"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#163B4A" />

            <!--dni-->
            <EditText
                android:id="@+id/edtDniUsuario"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input"
                android:hint="DNI"
                android:inputType="number"
                android:maxLength="9"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#163B4A" />

            <!-- contraseña -->
            <EditText
                android:id="@+id/edtClaveUsuario"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_input"
                android:hint="Contraseña (mínimo 6 caracteres)"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#163B4A" />

            <!--ayuda al editarr-->
            <TextView
                android:id="@+id/txtAyudaClave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Al editar, dejá la contraseña vacía para conservarla."
                android:textColor="#527080"
                android:textSize="12sp"
                android:visibility="gone" />

            <!--rol-->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Rol"
                android:textColor="#163B4A"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerRolUsuario"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!--guardar-->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGuardarUsuario"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_primary"
                android:text="GUARDAR USUARIO"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!--cargando-->
            <ProgressBar
                android:id="@+id/progresoGuardarUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
