<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F9FA"
    tools:context=".view.PacientesActivity">


    <!-- ENCABEZADO DONANTES -->
    <LinearLayout
        android:id="@+id/headerPacientes"
        android:layout_width="0dp"
        android:layout_height="105dp"
        android:background="@drawable/bg_header_decorativo"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnVolver"
                android:layout_width="40dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:contentDescription="Volver" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Donantes"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnNuevoDonante"
                android:layout_width="145dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_button_primary"
                android:text="+ Nuevo donante"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>


    <!-- CONTENIDO -->
    <LinearLayout
        android:id="@+id/contenidoPacientes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerPacientes">

        <!-- BUSCADOR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_buscar"
                app:tint="#087D91"
                android:contentDescription="Buscar" />

            <EditText
                android:id="@+id/edtBuscarPaciente"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Buscar por numero de DNI..."
                android:inputType="number"
                android:paddingStart="10dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:textColor="#163B4A"
                android:textColorHint="#7A858C"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/btnFiltros"
                android:layout_width="40dp"
                android:layout_height="48dp"
                android:padding="8dp"
                android:src="@drawable/ic_filtro"
                app:tint="#087D91"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Filtros" />

        </LinearLayout>


        <!-- FILTROS RÁPIDOS -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/filtroTodos"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Todos"
                    android:textColor="#F7065D"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/filtroAptos"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Aptos"
                    android:textColor="#527080"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/filtroNoAptos"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="No aptos"
                    android:textColor="#527080"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/filtroRestriccion"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Con restricción"
                    android:textColor="#527080"
                    android:textSize="14sp" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- LISTADO DE DONANTES -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerDonantes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingBottom="12dp"
            android:scrollbars="vertical"
            tools:listitem="@layout/item_donante" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>