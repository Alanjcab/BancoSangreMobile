<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_home_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- ÍCONO DEL DONANTE -->
    <ImageView
        android:id="@+id/imgDonante"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_card_rosa"
        android:padding="8dp"
        android:src="@drawable/ic_donantes"
        app:tint="#F7065D"
        android:contentDescription="Donante" />

    <!-- DATOS DEL DONANTE -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtNombreDonante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Juan Pérez"
            android:textColor="#163B4A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtDniDonante"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DNI 28.123.456"
                android:textColor="#527080"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtGrupoSanguineo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="A+"
                android:textColor="#163B4A"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>

    <!-- ESTADO DE APTITUD -->
    <TextView
        android:id="@+id/txtEstadoDonante"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_estado_apto"
        android:paddingStart="10dp"
        android:paddingTop="7dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp"
        android:text="Apto"
        android:textColor="#16875D"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- FLECHA -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="›"
        android:textColor="#163B4A"
        android:textSize="26sp" />

</LinearLayout>
